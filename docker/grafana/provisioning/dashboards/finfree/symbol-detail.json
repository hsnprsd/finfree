      "pluginVersion": "13.2.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "queryType": "timeseries",
          "rawSql": "WITH daily AS (\n  SELECT date, argMax(close, ingested_at) AS close\n  FROM market_data\n  WHERE symbol = ${symbol:singlequote} AND $__dateFilter(date)\n  GROUP BY date\n), returns AS (\n  SELECT\n    date,\n    close,\n    lagInFrame(close, 1, 0) OVER (ORDER BY date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS previous_close\n  FROM daily\n)\nSELECT\n  toDateTime(date) AS time,\n  round((close / previous_close - 1) * 100, 2) AS daily_return\nFROM returns\nWHERE previous_close > 0\nORDER BY date",
          "refId": "A"
        }
      ],
      "title": "$symbol Daily Return",
      "type": "timeseries"
