      "pluginVersion": "13.2.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "queryType": "table",
          "rawSql": "WITH daily AS (\n  SELECT\n    date,\n    argMax(close, ingested_at) AS close,\n    argMax(volume, ingested_at) AS volume\n  FROM market_data\n  WHERE symbol = ${symbol:singlequote} AND $__dateFilter(date)\n  GROUP BY date\n), latest AS (\n  SELECT max(date) AS latest_date FROM daily\n)\nSELECT\n  argMax(close, date) AS latest_close,\n  round((argMax(close, date) / argMaxIf(close, date, date < (SELECT latest_date FROM latest)) - 1) * 100, 2) AS daily_change,\n  round((argMax(close, date) / argMin(close, date) - 1) * 100, 2) AS period_return,\n  round(avg(toFloat64(close) * volume), 0) AS average_traded_value\nFROM daily",
          "refId": "A"
        }
      ],
      "title": "$symbol Snapshot",
      "type": "stat"
    },
