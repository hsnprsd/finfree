          "rawSql": "WITH daily AS (\n  SELECT symbol, date, argMax(close, ingested_at) AS close, argMax(volume, ingested_at) AS volume\n  FROM market_data\n  WHERE $__dateFilter(date)\n  GROUP BY symbol, date\n)\nSELECT\n  toDateTime(date) AS time,\n  sum(toFloat64(close) * volume) AS traded_value\nFROM daily\nGROUP BY date\nORDER BY date",
