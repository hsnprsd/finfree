      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "queryType": "table",
          "rawSql": "WITH daily AS (\n  SELECT\n    symbol,\n    date,\n    argMax(name, ingested_at) AS name,\n    argMax(close, ingested_at) AS close,\n    argMax(volume, ingested_at) AS volume\n  FROM market_data\n  WHERE $__dateFilter(date)\n  GROUP BY symbol, date\n), latest AS (\n  SELECT max(date) AS latest_date FROM daily\n), snapshot AS (\n  SELECT\n    symbol,\n    argMax(name, date) AS name,\n    argMax(close, date) AS latest_close,\n    argMaxIf(close, date, date < (SELECT latest_date FROM latest)) AS previous_close,\n    argMax(volume, date) AS latest_volume\n  FROM daily\n  GROUP BY symbol\n)\nSELECT\n  symbol,\n  name,\n  latest_close AS close,\n  round((latest_close / previous_close - 1) * 100, 2) AS change_percent,\n  latest_volume AS volume,\n  round(toFloat64(latest_close) * latest_volume, 0) AS traded_value\nFROM snapshot\nWHERE previous_close > 0\nORDER BY abs(change_percent) DESC\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Top Movers",
      "type": "table"
