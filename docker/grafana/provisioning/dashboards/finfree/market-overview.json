      "pluginVersion": "13.2.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "queryType": "table",
          "rawSql": "WITH daily AS (\n  SELECT symbol, date, argMax(close, ingested_at) AS close, argMax(volume, ingested_at) AS volume\n  FROM market_data\n  WHERE $__dateFilter(date)\n  GROUP BY symbol, date\n), latest AS (\n  SELECT max(date) AS latest_date FROM daily\n), snapshot AS (\n  SELECT\n    symbol,\n    argMax(close, date) AS latest_close,\n    argMaxIf(close, date, date < (SELECT latest_date FROM latest)) AS previous_close,\n    argMax(volume, date) AS latest_volume\n  FROM daily\n  GROUP BY symbol\n)\nSELECT\n  count() AS active_symbols,\n  round(avgIf((latest_close / previous_close - 1) * 100, previous_close > 0), 2) AS equal_weight_return,\n  round(sum(toFloat64(latest_close) * latest_volume), 0) AS traded_value,\n  countIf(latest_close > previous_close) - countIf(latest_close < previous_close) AS net_breadth\nFROM snapshot",
          "refId": "A"
        }
      ],
      "title": "Latest Market Snapshot",
      "type": "stat"
    },
